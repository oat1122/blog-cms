# ============================================================
# blog-cms — ตัวอย่างไฟล์ Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env ขึ้น git)
# ทุกตัวแปรในไฟล์นี้ต้องถูก validate ด้วย Zod ที่ src/core/config/env.ts
# ============================================================

# --- Database (PostgreSQL ผ่าน Drizzle) ---
DATABASE_URL="postgresql://user:password@localhost:5432/blog_cms"

# --- NextAuth ---
# สร้างค่าได้ด้วย: openssl rand -base64 32
AUTH_SECRET="เปลี่ยนเป็นค่าสุ่มของคุณ"
AUTH_URL="http://localhost:3000"

# --- App ---
NODE_ENV="development"
